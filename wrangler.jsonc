{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app-floating-temple",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-22",
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/audio/*"]
  }
}